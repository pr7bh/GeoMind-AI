# GeoMind AI backend configuration.
# Local: copy to backend/.env and run
#   .venv/bin/uvicorn app.main:app --reload --env-file .env
# Render: set these in the service's Environment settings (never commit real keys).

# Comma-separated origins allowed by CORS (your Vercel URL in production).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM provider: none | ollama | remote
#   none   - no LLM; direct requests ("Find hospitals within 5 km") still work
#   ollama - local development only
#   remote - any OpenAI-compatible /chat/completions API (production)
LLM_PROVIDER=none

# Local Ollama (development only; never on Render)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Remote OpenAI-compatible provider (production)
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=
# LLM_MODEL=

# Limits (optional; values are clamped to safe ranges)
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_TOKENS=700
# AGENT_MAX_ITERATIONS=3
# AGENT_TIMEOUT_SECONDS=90

# Optional Overpass mirror
# OVERPASS_URL=https://overpass-api.de/api/interpreter
